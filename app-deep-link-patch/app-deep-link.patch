 struct PendingAuth(Mutex<Option<String>>);
 
+/// Buffer for an in-app route requested by a `myra://patrol/new?template=…`
+/// deep link that arrives before the webview's `tray-navigate` listener is
+/// ready (the link can launch the app cold). The frontend drains it via
+/// `take_pending_navigation` on mount, mirroring the auth-code flow above.
+#[derive(Default)]
+struct PendingNavigation(Mutex<Option<String>>);
+
 /// Where the hosted web app's desktop login bridge page lives. The desktop
 /// opens `<base>/auth/desktop/` in the system browser; the bridge runs Clerk,
 /// then deep-links back with a one-time handoff code.
@@ -56,6 +63,32 @@ fn parse_auth_code(url: &url::Url) -> Option<String> {
         .filter(|c| !c.is_empty())
 }
 
+/// Map a `myra://patrol/new?template=<id>` deep link (the "Open in Myra" links
+/// on the landing site's templates page) to the in-app editor route
+/// `/schedules/edit/?template=<id>`. Returns `None` for any other URL.
+///
+/// The template id is restricted to a conservative charset so a crafted link
+/// can never smuggle extra path or query segments into the route we hand the
+/// frontend router. Unknown ids are still routed — the editor falls back to a
+/// blank draft when the id matches no template.
+fn parse_patrol_template(url: &url::Url) -> Option<String> {
+    if url.scheme() != "myra" {
+        return None;
+    }
+    // host = "patrol", path = "/new" (tolerate a trailing slash).
+    if url.host_str() != Some("patrol") || url.path().trim_end_matches('/') != "/new" {
+        return None;
+    }
+    let template = url
+        .query_pairs()
+        .find(|(k, _)| k == "template")
+        .map(|(_, v)| v.into_owned())
+        .filter(|t| {
+            !t.is_empty() && t.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
+        })?;
+    Some(format!("/schedules/edit/?template={template}"))
+}
+
 /// The stable port the persistent local service listens on. When a service is
 /// running here we *adopt* it instead of spawning a duplicate writer on
 /// `~/.myra-agents`.
@@ -672,6 +705,14 @@ fn take_pending_auth_code(state: tauri::State<'_, PendingAuth>) -> Option<String
     state.0.lock().ok().and_then(|mut c| c.take())
 }
 
+/// Drain any navigation target buffered before the frontend's `tray-navigate`
+/// listener mounted (a `myra://patrol/new?template=…` deep link can launch the
+/// app cold, before the webview is ready).
+#[tauri::command]
+fn take_pending_navigation(state: tauri::State<'_, PendingNavigation>) -> Option<String> {
+    state.0.lock().ok().and_then(|mut c| c.take())
+}
